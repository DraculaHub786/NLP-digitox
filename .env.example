# Environment variables for NLP digitox.
#
# Copy to `.env` and fill in real values:
#   cp .env.example .env
#
# `.env` is gitignored and is NOT bundled into the app (it was removed from the
# `assets:` section of pubspec.yaml so it can no longer leak into the APK).
# Pass it at build time instead:
#   flutter run   --dart-define-from-file=.env
#   flutter build appbundle --dart-define-from-file=.env
#
# Resolution order is handled by `lib/config/api_keys.dart`:
#   1. --dart-define=KEY=value   (or --dart-define-from-file=.env)
#   2. the bundled .env asset (no longer present - step 1 is now the only source)
#   3. the empty literal in api_keys.dart
#
# The background isolate (nightly sentiment scoring) has no asset access either,
# so it too only ever sees step 1 - pass --dart-define-from-file for that job.

# --- AI / NLP keys ----------------------------------------------------------
# Free Groq key: https://console.groq.com/keys
# Powers the chatbot, sentiment analysis, nightly scoring and monthly report.
GROQ_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Cloudinary: profile picture uploads ------------------------------------
# See lib/core/services/profile_service.dart. Without CLOUD_NAME/UPLOAD_PRESET,
# uploads fail outright.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Without this, uploads still work but OLD profile pictures are never deleted
# from Cloudinary - they silently pile up (an unsigned upload preset can't
# overwrite or delete on its own, so cleanup is delegated to an n8n webhook
# that holds the real Cloudinary API secret).
# The app sends no shared secret; it sends the caller's Firebase ID token as
# `Authorization: Bearer <token>`, which n8n verifies before doing anything.
# The workflow also validates that publicId starts with 'profile_pics/{uid}_'
# so it cannot be used to delete arbitrary assets.
# CLOUDINARY_CLEANUP_WEBHOOK_URL is configured in n8n, not in the app.
CLOUDINARY_CLEANUP_WEBHOOK_URL=

# --- Shared focus sessions: n8n webhooks ------------------------------------
# Both are optional. With them empty, shared sessions still run exactly as
# before; the completion webhook is simply never called, and points stay
# client-awarded.
#
# SESSION_COMPLETE_WEBHOOK_URL is called by each device when its shared run
# reaches its end time. The workflow verifies the Firebase ID token, re-reads
# the session through the RTDB REST API with a service account, and — only if
# the run really finished with the member present and within the break
# allowance — writes sessionResults/{sid}/{uid} and credits points. The client
# never writes points for this reason.
SESSION_COMPLETE_WEBHOOK_URL=
# Sent as the x-digitox-secret header so the workflow can reject calls that did
# not come from the app. Generate a long random string and set the same value
# in the n8n credential.
SESSION_WEBHOOK_SECRET=

# --- Server-side only. NEVER put these in the app. --------------------------
# SESSION_CLEANUP_WEBHOOK_URL belongs to the n8n cron that deletes stale
# sessions and expired invites; the app never calls it, so it is not read from
# the bundled .env in normal builds. Documented here so the whole set of
# endpoint names lives in one place.
# SESSION_CLEANUP_WEBHOOK_URL=
# Used by n8n/the Cloudinary cleanup workflow, not by lib/.
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
