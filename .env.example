# Environment variables for NLP digitox
# Copy this file to .env and fill in your real values.
# Never commit .env - it holds real secrets.

GROQ_API_KEY=
GEMINI_API_KEY=

# Cloudinary — profile picture uploads (see lib/core/services/profile_service.dart).
# Without CLOUD_NAME/UPLOAD_PRESET, uploads fail outright.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Without these two, uploads still work but OLD profile pictures are never
# deleted from Cloudinary — they silently pile up (an unsigned upload preset
# can't overwrite or delete on its own, so cleanup is delegated to an n8n
# webhook that holds the real Cloudinary API secret).
CLOUDINARY_CLEANUP_WEBHOOK_URL=
CLOUDINARY_CLEANUP_WEBHOOK_SECRET=
