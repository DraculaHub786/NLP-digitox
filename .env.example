# Environment variables for NLP digitox.
#
# Copy to `.env` and fill in real values:
#   cp .env.example .env
#
# `.env` is gitignored and IS bundled into the app (see the `assets:` section of
# pubspec.yaml), so keys reach the app in debug builds with no extra flags.
#
# Resolution order is handled by `lib/config/api_keys.dart`:
#   1. --dart-define=KEY=value   (or --dart-define-from-file=.env)
#   2. the bundled .env asset
#   3. the empty literal in api_keys.dart
#
# Because step 1 wins, release builds can keep keys out of the asset entirely by
# building with:  flutter build appbundle --dart-define-from-file=.env
# The background isolate (nightly sentiment scoring) has no asset access, so it
# only ever sees step 1 - pass --dart-define-from-file for that job to work.

# --- AI / NLP keys ----------------------------------------------------------
# Free Groq key: https://console.groq.com/keys
# Powers the chatbot, sentiment analysis, nightly scoring and monthly report.
GROQ_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Cloudinary: profile picture uploads ------------------------------------
# See lib/core/services/profile_service.dart. Without CLOUD_NAME/UPLOAD_PRESET,
# uploads fail outright.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Without these two, uploads still work but OLD profile pictures are never
# deleted from Cloudinary - they silently pile up (an unsigned upload preset
# can't overwrite or delete on its own, so cleanup is delegated to an n8n
# webhook that holds the real Cloudinary API secret).
# The webhook validates that publicId starts with 'profile_pics/{uid}_' so it
# cannot be used to delete arbitrary assets.
# CLOUDINARY_CLEANUP_WEBHOOK_URL is configured in n8n, not in the app.
CLOUDINARY_CLEANUP_WEBHOOK_URL=
CLOUDINARY_CLEANUP_WEBHOOK_SECRET=

# --- Server-side only. NEVER put these in the app. --------------------------
# Used by n8n/the Cloudinary cleanup workflow, not by lib/.
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
