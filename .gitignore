# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/
temp/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder is ignored except for launch.json (needed so
# `flutter run` from the editor passes --dart-define-from-file=.env —
# without it, Cloudinary/Groq/Gemini keys are silently empty at runtime).
.vscode/*
!.vscode/launch.json

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
untranslated_strings.json

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/app/.cxx/
/android/build

# Additional build outputs
/android/.gradle
/ios/Pods/
/ios/.symlinks/
/ios/Flutter/Flutter.framework
/ios/Flutter/Flutter.podspec

# Environment variables and API keys
.env
.env.*
!.env.example

# Android keystore and signing (gitignored — must exist locally / in CI secrets)
android/key.properties
android/app/*.jks
android/app/*.keystore

# NOTE: lib/config/api_keys.dart is deliberately COMMITTED.
# It is the resolver that reads keys from .env / --dart-define, and the AI
# services import it, so it must exist in a fresh clone and in CI. It holds no
# secrets by design - keep real keys in .env (ignored above) or pass them with
# --dart-define. Only genuinely secret-bearing files are ignored here:
/api_keys.dart
**/api_keys_secret.dart

# Large generated files
/lib/l10n/generated/

# Node dependencies and npm scratch (the rules tests, Cloud Functions, and any
# ad-hoc npm install run inside the repo). `npm install` recreates all of it and
# none of it is source, so it must not be committed or pushed.
**/node_modules/
**/.npm/
**/package-lock.json
**/node_modules/.package-lock.json
**/npm-debug.log*
**/yarn-error.log*
**/*.tsbuildinfo

# Firebase emulator output written next to the config that started it.
**/firebase-debug.log
**/firebase-debug.*.log
**/database-debug.log
**/firestore-debug.log
**/ui-debug.log
**/*-debug.log

# Firebase Cloud Functions
/functions/lib/
/functions/.runtimeconfig.json
/functions/.env
/functions/.env.*
/functions/.firebase/
/functions/.eslintcache

# Scratch output from local test/analysis runs.
/rules_test_out.txt
/test_out.txt
/*_out.txt

# Realtime Database rules test scratch (kept out of the push).
/test/rules/.firebase/

