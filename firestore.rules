rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User data access rules
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Habits subcollection
      match /habits/{habitId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Tasks subcollection
      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Chat sessions subcollection
      match /chats/{chatId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Settings and preferences
      match /settings/{settingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Shared sessions - readable by members
    match /shared_sessions/{sessionId} {
      allow read: if request.auth != null && 
        (get(/databases/$(database)/documents/shared_sessions/$(sessionId)).data.members[request.auth.uid] != null ||
         get(/databases/$(database)/documents/shared_sessions/$(sessionId)).data.visibility == 'public');
      
      allow write: if request.auth != null &&
        (get(/databases/$(database)/documents/shared_sessions/$(sessionId)).data.owner == request.auth.uid ||
         get(/databases/$(database)/documents/shared_sessions/$(sessionId)).data.members[request.auth.uid] != null);
      
      allow create: if request.auth != null;
    }
    
    // Groups - readable by members or if public
    match /groups/{groupId} {
      allow read: if request.auth != null && 
        (get(/databases/$(database)/documents/groups/$(groupId)).data.members[request.auth.uid] != null ||
         get(/databases/$(database)/documents/groups/$(groupId)).data.visibility == 'public');
      
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/groups/$(groupId)).data.owner == request.auth.uid;
      
      allow create: if request.auth != null;
    }
    
    // Leaderboard - all authenticated users can read; each user can write only their own doc
    match /leaderboard/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Leaderboard config - readable by all authenticated; only service accounts can write
    match /leaderboard_config/{configDoc} {
      allow read: if request.auth != null;
      allow write: if false; // Only n8n cron / admin writes
    }
    
    // Public content - readable by all authenticated users
    match /public/{document=**} {
      allow read: if request.auth != null;
      allow write: if false; // Only admin can write
    }
  }
}
