rules_version = "2";
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User data access rules
    match /users/{userId} {
      // Allow users to read their own data fully. Write access remains restricted to the document owner.
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && (!("profileImageUrl" in request.resource.data)
            || request.resource.data.profileImageUrl == null
            || request.resource.data.profileImageUrl
                 .matches("https://res\\.cloudinary\\.com/ucarrdxh/.*")
            || request.resource.data.profileImageUrl
                 .matches("https://lh3\\.googleusercontent\\.com/.*"));
      
      // Habits subcollection
      match /habits/{habitId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Tasks subcollection
      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Chat sessions subcollection
      match /chats/{chatId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Settings and preferences
      match /settings/{settingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Daily sentiment scores subcollection - owner only. The client writes,
      // reads and prunes these, and the monthly report reads the 30-day window
      // from them. Rules are NOT inherited from the parent `users/{userId}`
      // document, so without this block every read and write here is denied.
      match /daily_sentiment_scores/{dayKey} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Monthly AI wellbeing reports subcollection - owner only. The client
      // stores, regenerates and lists these (`yyyy-MM` document ids).
      match /monthly_wellbeing_reports/{monthKey} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // NOTE: live shared sessions live in the Realtime Database, not here. The
    // old `shared_sessions` collection was never written by the shipped client
    // and its rules were self-referential (`get()` on the document being read),
    // which is denied by the rules engine. It is deliberately gone.

    // ---------------------------------------------------------------------
    // Groups (Phase 3) — durable, queryable membership on Firestore.
    //
    // Membership is a *subcollection* document, not a map field, so the rule
    // can use `exists()` rather than a `get()` that has to fetch the parent on
    // every access, and so a member cannot be added by rewriting the group
    // document. Roles are checked against that same membership document.
    // ---------------------------------------------------------------------
    match /groups/{groupId} {
      function isMember() {
        return request.auth != null &&
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
      }

      function isOwner() {
        return request.auth != null &&
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == "owner";
      }

      function isAdmin() {
        return request.auth != null &&
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ["owner", "admin"];
      }

      // Reading a group requires membership. `isMember()` returns false before
      // the membership document exists, which is exactly what makes a
      // newly-created group readable only by its creator.
      allow read: if isMember();

      // Only an existing owner/admin may edit the group document itself.
      allow update: if isAdmin();

      // Creation: any signed-in user, but the creator must own it.
      allow create: if request.auth != null &&
        request.resource.data.ownerId == request.auth.uid;

      // Only the owner can delete the group.
      allow delete: if isOwner();

      match /members/{memberId} {
        // Every member can see the roster.
        allow read: if isMember();

        // A user may add themselves as the initial owner, or an admin may add
        // anyone else.
        allow create: if request.auth != null &&
          ((memberId == request.auth.uid &&
            (!exists(/databases/$(database)/documents/groups/$(groupId)) ||
             get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid)) ||
           isAdmin());

        // An admin may change roles; a member may only update their own
        // profile fields and cannot escalate their own role.
        allow update: if isAdmin() ||
          (request.auth != null && memberId == request.auth.uid &&
           request.resource.data.role == resource.data.role);

        // A member may remove themselves; an admin may remove others.
        allow delete: if isAdmin() ||
          (request.auth != null && memberId == request.auth.uid);
      }

      // Scheduled sessions — admins create and edit, members read.
      match /schedule/{scheduleId} {
        allow read: if isMember();
        allow write: if isAdmin();
      }

      // Per-member stats are written by the points webhook through a service
      // account only; the client reads its own row for the group screen.
      match /stats/{uid} {
        allow read: if isMember();
        allow write: if false;
      }
    }

    // ---------------------------------------------------------------------
    // Safety (Phase 5) — reports and blocks.
    // ---------------------------------------------------------------------
    match /reports/{reportId} {
      // Any signed-in user may file a report; only the reporter may read it
      // back. Review happens server-side with a service account.
      allow create: if request.auth != null &&
        request.resource.data.reporterUid == request.auth.uid;
      allow read: if request.auth != null &&
        resource.data.reporterUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /blocks/{uid}/blocked/{blockedUid} {
      // A user's own block list, and nothing else.
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    
    // Leaderboard - all authenticated users can read; each user can write only their own doc
    match /leaderboard/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && (
             !exists(/databases/$(database)/documents/leaderboard/$(userId))
             || request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(["profileImageUrl", "profileImagePublicId", "username"])
           )
        && (!("profileImageUrl" in request.resource.data)
            || request.resource.data.profileImageUrl == null
            || request.resource.data.profileImageUrl
                 .matches("https://res\\.cloudinary\\.com/ucarrdxh/.*")
            || request.resource.data.profileImageUrl
                 .matches("https://lh3\\.googleusercontent\\.com/.*"));
    }
    
    // Leaderboard config - readable by all authenticated; only service accounts can write
    match /leaderboard_config/{configDoc} {
      allow read: if request.auth != null;
      allow write: if false; // Only n8n cron / admin writes
    }
    
    // Public content - readable by all authenticated users
    match /public/{document=**} {
      allow read: if request.auth != null;
      allow write: if false; // Only admin can write
    }
    
    // Badges - winner records; doc ID encodes owner ({uid}_{period}_{periodId}),
    // so only the owner can read their own badges. Write is service-account only (n8n).
    match /badges/{badgeId} {
      allow read: if request.auth != null &&
        badgeId.matches(request.auth.uid + "_.*");
      allow write: if false; // n8n service account only
    }
    
    // Badge verification - not read by the client today. If a public
    // verify-by-link page needs it later, allow single-document `get` only so
    // IDs cannot be listed:
    //   allow get: if request.auth != null;
    match /badge_verification/{verificationId} {
      allow read: if false;
      allow write: if false; // n8n service account only
    }
    
    // Weekly leaderboard - all authenticated users can read; each user writes only their own doc
    match /weekly_leaderboard/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && (!("profileImageUrl" in request.resource.data)
            || request.resource.data.profileImageUrl == null
            || request.resource.data.profileImageUrl
                 .matches("https://res\\.cloudinary\\.com/ucarrdxh/.*")
            || request.resource.data.profileImageUrl
                 .matches("https://lh3\\.googleusercontent\\.com/.*"));
    }
    
    // Monthly leaderboard - same pattern
    match /monthly_leaderboard/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && (!("profileImageUrl" in request.resource.data)
            || request.resource.data.profileImageUrl == null
            || request.resource.data.profileImageUrl
                 .matches("https://res\\.cloudinary\\.com/ucarrdxh/.*")
            || request.resource.data.profileImageUrl
                 .matches("https://lh3\\.googleusercontent\\.com/.*"));
    }
  }
}
